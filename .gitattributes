# Auto detect text files and normalize line endings to LF
* text=auto
# Unity files
*.cs diff=csharp text eol=lf
*.cginc text eol=lf
*.shader text eol=lf
*.mat binary
*.prefab binary
*.unity binary
*.scene binary
*.asset binary
*.anim binary
*.controller binary
*.physicMaterial binary
*.physicsMaterial2D binary
*.guiskin binary
*.fontsettings binary
*.fnt binary
# Audio formats
*.mp3 binary
*.wav binary
*.ogg binary
*.aif binary
*.aiff binary
*.au binary
*.mid binary
*.midi binary
*.xm binary
*.mod binary
*.it binary
*.s3m binary
# Video formats
*.mov binary
*.mpeg binary
*.mpg binary
*.avi binary
*.asf binary
*.divx binary
*.dv binary
*.f4v binary
*.flv binary
*.ogv binary
*.vob binary
*.wmv binary
*.webm binary
# Image formats
*.psd binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.tga binary
*.tif binary
*.tiff binary
*.pict binary
*.svg text
# Compression formats
*.zip binary
*.7z binary
*.gz binary
*.rar binary
*.tar binary
# Other binary formats
*.a binary
*.exr binary
*.cubemap binary
*.unitypackage binary
*.bundle binary
# Gradle files (if using Android)
*.gradle text eol=lf
gradle-wrapper.properties text eol=lf
# Documentation
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
# Project config
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.fbx filter=lfs diff=lfs merge=lfs -text
